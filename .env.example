# Copia este archivo como `.env.local` y completa tus valores.
# En Vercel: Project → Settings → Environment Variables (mismos nombres).

# URL pública del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=tu_url_de_supabase

# Clave pública anon (Settings → API → anon public). Protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_de_supabase

# NUNCA expongas la service_role key al cliente: solo en servidor
# (Vercel → Environment Variables, sin prefijo NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=solo-servidor-no-usar-en-cliente

# --- Analítica (todas opcionales; sin IDs no se carga ningún tracker) ---
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=token-de-search-console
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999